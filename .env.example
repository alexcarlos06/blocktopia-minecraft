
# ==========================================
# BLOCKTOPIA - MINECRAFT BEDROCK
# ==========================================

# Rede - NetherNet
MINECRAFT_PORT=19132
SERVER_UDP_PORTS=<IP_Publico>:19140-19155:19140-19155

# Armazenamento persistente
MINECRAFT_DATA_DIR=/home/users/projects/minecraft-data

# Identificacao do servidor e mundo
SERVER_NAME=Blocktopia
LEVEL_NAME=Blocktopia
LEVEL_SEED=-1558669866333825156
VIEW_DISTANCE=16
TICK_DISTANCE=4

# Jogabilidade
GAMEMODE=survival
DIFFICULTY=easy
MAX_PLAYERS=10

# Temporariamente ativo para configurar
# gamerules e bau inicial
ALLOW_CHEATS=true

# Seguranca
ONLINE_MODE=true
ALLOW_LIST=true

# Permissoes
# Conta compartilhada com as criancas
OPS=
MEMBERS=UUID
VISITORS=

# Jogadores autorizados
ALLOW_LIST_USERS=GamerTagPipiMeme:UUID
